{
  "name": "portfolio-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check",
    "deploy": "bun run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply portfolio-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply portfolio-db --remote",
    "seed:dev": "bun scripts/seed-dev.ts"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/poppins": "5.3.0",
    "@hookform/resolvers": "3.10.0",
    "@radix-ui/react-alert-dialog": "1.1.24",
    "@radix-ui/react-dialog": "1.2.0",
    "@radix-ui/react-icons": "1.3.2",
    "@radix-ui/react-label": "2.1.16",
    "@radix-ui/react-scroll-area": "1.3.0",
    "@radix-ui/react-slot": "1.4.0",
    "@radix-ui/react-switch": "1.3.8",
    "@radix-ui/react-tabs": "1.1.22",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
