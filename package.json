    "drizzle-zod": "0.5.1",
    "lucide-react": "0.399.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-dropzone": "14.4.1",
    "react-hook-form": "7.89.0",
    "sonner": "1.7.4",
    "tailwind-merge": "2.6.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
